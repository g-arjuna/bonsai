# bonsai.toml — reference configuration
#
# Copy this file to bonsai.toml and edit before starting bonsai.
# All sections are optional unless marked REQUIRED.
# All defaults match the values shown in the comments.
#
# Quick start (no lab):
#   cp bonsai.toml.example bonsai.toml
#   # Set BONSAI_VAULT_PASSPHRASE in your environment.
#   # Add at least one [[target]] block below.
#   ./bonsai  (or: docker compose --profile standalone up -d)

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Path to the lbug graph database file.
# Created on first start. Use an absolute path in production.
graph_path = "runtime/bonsai.db"

# ── Listen Addresses ─────────────────────────────────────────────────────────
#
# HTTP UI and REST API server (browser/curl). Default: "0.0.0.0:3000".
# Also controlled by BONSAI_HTTP_PORT env var in the container healthcheck.
# Changing this requires a process restart.
# http_addr = "0.0.0.0:3000"
#
# gRPC API server (collector→core channel + CLI tools). Default: "[::1]:50051".
# Use "0.0.0.0:50051" in Docker or distributed deployments.
# Changing this requires a process restart.
# api_addr = "[::1]:50051"
#
# Prometheus /metrics HTTP listener. Default: "[::1]:9090". Set to "" to disable.
# metrics_addr = "[::1]:9090"
#
# Signal receiver addresses (require restart; ports < 1024 need root or
# cap_net_bind_service):
#   [signals.syslog]  udp_addr = "0.0.0.0:5514"  tcp_addr = "0.0.0.0:6514"
#   [signals.snmp]    udp_addr = "0.0.0.0:9162"
#   [streaming.bmp]   tcp_addr = "0.0.0.0:5000"
#   [streaming.bgp_ls]tcp_addr = "127.0.0.1:15071"
#   [streaming.pcep]  tcp_addr = "0.0.0.0:4189"
#   [streaming.otlp]  http_addr= "0.0.0.0:4318"
#   [streaming.netflow]udp_addr= "0.0.0.0:2055"
#   [streaming.sflow]  udp_addr= "0.0.0.0:6343"

# ── [runtime] ────────────────────────────────────────────────────────────────

[runtime]
# One binary, three modes:
#   "all"       — runs both the core (graph, API, change detection) and the
#                 local collector (gNMI subscriber). Single-machine default.
#   "core"      — core only (graph + API). Used in distributed deployments.
#   "collector" — collector only (gNMI subscriber, forwards to a remote core).
# Default: "all"
mode = "all"

# Stable identifier for this collector instance.
# Stored on every TelemetryIngest record — use something meaningful in
# distributed setups (e.g. "site-a-collector-1").
# Default: "local"
collector_id = "local"

# Core gRPC endpoint used when mode = "collector".
# Must point at the bonsai core's api_addr.
# Default: "http://[::1]:50051"
# core_ingest_endpoint = "http://[::1]:50051"

# Optional resource profile override: tiny|small|medium|large|xlarge.
# Auto-detected from system RAM by default.
# resource_profile = "medium"

# [runtime.tls] — mTLS for the distributed collector-core channel.
# Only needed when mode = "collector" and the core requires TLS.
# [runtime.tls]
# enabled = true
# ca_cert = "config/tls/ca.pem"          # CA that signed both core and collector certs
# cert    = "config/tls/collector.pem"   # This process's certificate chain
# key     = "config/tls/collector-key.pem"
# server_name = "bonsai-core.local"      # SNI name on the core's certificate

# ── [graph] ──────────────────────────────────────────────────────────────────

[graph]
# LadybugDB buffer pool size in bytes.
# Auto-detected: min(2 GiB, 25 % of RAM) for core; min(256 MiB, 10 %) for collector.
# Uncomment to override. Use larger values on dedicated servers.
# buffer_pool_bytes = 2147483648   # 2 GiB

# ── [credentials] ────────────────────────────────────────────────────────────

[credentials]
# Directory containing the encrypted credential vault (vault.age + metadata.json).
# Default: "bonsai-credentials"
path = "bonsai-credentials"

# Environment variable that holds the vault passphrase.
# The passphrase must be present in the environment at startup.
# Best practice: use an EnvironmentFile in systemd (600 permissions), not
# inline Environment= (visible in /proc/<pid>/environ).
# Default: "BONSAI_VAULT_PASSPHRASE"
passphrase_env = "BONSAI_VAULT_PASSPHRASE"

# ── [retention] ──────────────────────────────────────────────────────────────

[retention]
# Enable periodic pruning of old StateChangeEvents. Default: true
enabled = true

# Delete StateChangeEvents older than this many hours. Default: 24
max_age_hours = 24

# Hard cap on total StateChangeEvents kept. 0 = unlimited. Default: 10000
max_state_change_events = 10000

# ── [archive] ────────────────────────────────────────────────────────────────

[archive]
# Enable the Parquet archive consumer.
# Required for GNN training data accumulation.
# Default: false
enabled = false

# Root directory for Parquet archive output. Default: "archive"
path = "archive"

# Flush in-memory buffer to disk every N seconds. Default: 10
flush_interval_seconds = 10

# Also flush when the in-memory batch reaches this row count. Default: 1000
max_batch_rows = 1000

# ZSTD compression level. 1 = fastest, 22 = best. Default: 12
compression_level = 12

# Close idle partition writers after N seconds of inactivity. Default: 7200 (2h)
writer_max_idle_secs = 7200

# Force-rotate partition writers older than N seconds.
# Ensures at least one closed Parquet file per interval even under continuous ingest.
# Default: 3600 (1h)
max_file_age_seconds = 3600

# ── [storage] ────────────────────────────────────────────────────────────────

[storage]
# Maximum bytes the archive directory may use before aggressive retention kicks in.
# 0 = unlimited. Default: 10737418240 (10 GB)
max_archive_bytes = 10737418240

# Maximum bytes the graph database directory may use.
# 0 = unlimited. Default: 5368709120 (5 GB)
max_graph_bytes = 5368709120

# How often (seconds) to check disk usage. Default: 300 (5 min)
check_interval_secs = 300

# Log a warning when usage exceeds this percentage of the configured max. Default: 80
warn_threshold_pct = 80

# ── [ingest] ─────────────────────────────────────────────────────────────────

[ingest]
# Minimum interval (seconds) between counter writes per (device, interface).
# Suppresses identical counter telemetry updates that arrive faster than this.
# Default: 10
counter_debounce_secs = 10

# Total RAM budget for the three ingest debounce LRU caches combined.
# Default: 16777216 (16 MiB)
debounce_memory_bytes = 16777216

# [ingest.backpressure] — shed load when lbug buffer pool is under pressure.
[ingest.backpressure]
# Drop non-critical updates when buffer pool reaches this % of capacity. Default: 75
level_1_pct = 75

# Drop all but exempt paths when buffer pool reaches this % of capacity. Default: 90
level_2_pct = 90

# gNMI subscription paths exempt from backpressure shedding (always kept).
# Example: interface oper-state, BGP session state — events that must not be lost.
# exemptions = ["/interface[name=*]/oper-state", "/network-instance[name=*]/protocols/bgp"]
exemptions = []

# ── [event_bus] ──────────────────────────────────────────────────────────────

[event_bus]
# Broadcast channel capacity for the internal event bus.
# Increase if high-frequency labs cause "lagged" warnings. Default: 2048
capacity = 2048

# ── [layered_ingestion] ──────────────────────────────────────────────────────

[layered_ingestion]
# Enable the config-state change detection layer (gNMI GET + diff + parse).
# Disable only for bare telemetry-only deployments. Default: true
enabled = true

# Path for the layered ingestion config store (stores per-device config snapshots).
# Default: "runtime/config-store"
config_store_path = "runtime/config-store"

# How often (seconds) to schedule a full config fetch cycle for all managed devices.
# Default: 3600 (1h)
change_detection_schedule_interval_secs = 3600

# How often (seconds) to force a full re-parse of all stored configs.
# Default: 604800 (7 days)
change_detection_reparse_interval_secs = 604800

# Maximum number of historical config snapshots retained per device.
# Default: 25
history_limit = 25

# Additional gNMI GET paths to include in config fetch beyond the auto-selected profile.
# Example: ["/system/config", "/routing-policy/policy-definition"]
default_gnmi_get_paths = []

# Path to the vendor-specific gNMI known issues YAML file.
# Default: "config/gnmi_known_issues/default.yaml"
gnmi_known_issues_path = "config/gnmi_known_issues/default.yaml"

# Path to the directory of syslog parsing pattern files.
# Default: "config/syslog_patterns"
syslog_patterns_path = "config/syslog_patterns"

# [layered_ingestion.parser_chain] — multi-sidecar config parser settings.
[layered_ingestion.parser_chain]
# If true, require all parser sidecars to agree before accepting a parse result.
# Default: false
consensus_mode = false

# [layered_ingestion.parser_chain.sidecars] — parser sidecar HTTP endpoints.
[layered_ingestion.parser_chain.sidecars]
# pyATS/Genie parser sidecar (Docker: pyats-sidecar service).
# Default: "http://127.0.0.1:9101"
pyats_url = "http://127.0.0.1:9101"

# Bonsai native parser sidecar.
# Default: "http://127.0.0.1:9102"
native_url = "http://127.0.0.1:9102"

# ── [yang] ───────────────────────────────────────────────────────────────────

[yang]
# Root directory for the YANG model library (vendor YANG files).
# Default: "runtime/yang_catalogue"
library_root = "runtime/yang_catalogue"

# Directory for the compiled YANG schema cache.
# Default: "runtime/yang_cache"
cache_root = "runtime/yang_cache"

# Environment variable containing the YANG bundle decryption key.
# Default: "BONSAI_YANG_BUNDLE_KEY"
bundle_key_env = "BONSAI_YANG_BUNDLE_KEY"

# ── [collector] ──────────────────────────────────────────────────────────────

[collector]
# Collector-local lbug graph path (separate from the core graph).
# Default: "runtime/collector.db"
graph_path = "runtime/collector.db"

# Diagnostic HTTP server port for the collector process.
# Exposes /health, /api/readiness, /api/collector/status.
# 0 = disabled. Set BONSAI_COLLECTOR_DIAG_PASSWORD env var to require auth.
# Default: 0 (disabled)
diagnostic_port = 0

# [collector.queue] — disk-backed telemetry queue (buffering when core is unreachable).
[collector.queue]
# Directory for append-only queue files. Default: "runtime/collector-queue"
path = "runtime/collector-queue"

# Maximum queue size in bytes. 0 = unlimited. Default: 1073741824 (1 GiB)
max_bytes = 1073741824

# Drop records older than this many hours. 0 = unlimited. Default: 24
max_age_hours = 24

# Maximum records replayed in one batch when reconnecting to the core.
# Default: 1000
drain_batch_size = 1000

# Log queue depth at this interval (seconds). 0 = never. Default: 30
log_interval_seconds = 30

# [collector.filter] — control how counter telemetry is forwarded.
[collector.filter]
# Forwarding mode for counter updates:
#   "raw"       — forward every update as-is.
#   "debounced" — drop updates within the debounce window (reduces write traffic).
#   "summary"   — aggregate into time-windowed summaries (recommended for distributed).
# Default: "debounced"
counter_forward_mode = "debounced"

# Minimum interval (seconds) between counter forwards per (device, interface).
# Only used when counter_forward_mode = "debounced". Default: 10
counter_debounce_secs = 10

# Summary window duration in seconds.
# Only used when counter_forward_mode = "summary". Default: 60
counter_window_secs = 60

# Seconds of silence after which a partial summary window is flushed.
# Default: 70 (window + 10s)
counter_flush_idle_secs = 70

# ── [remediation] ────────────────────────────────────────────────────────────

[remediation]
# Seconds a proposal in "approved" state stays eligible for rollback.
# After this window closes, rollback is no longer available.
# Default: 60
rollback_window_secs = 60

# When true, bonsai automatically creates a pending RemediationProposal for
# every DetectionEvent that matches a known playbook.
# Start with false until you have reviewed your playbook catalogue.
# Default: false (D3-5 T1)
# auto_propose = false

# Directory that contains playbook YAML files (one file per detection rule ID).
# Each file must have a top-level `detection_rule_id` key and a `playbooks` list.
# Run `scripts/validate_playbooks.py` to validate before deploying.
# Default: "playbooks/library"
# playbook_library_dir = "playbooks/library"

# [remediation.graduation] — trust graduation thresholds.
[remediation.graduation]
# Number of consecutive operator approvals for a (rule, playbook) tuple before
# bonsai surfaces a "consider promoting to auto-approve" hint.
# Default: 10
consecutive_approvals_required = 10

# [remediation.defaults] — initial TrustState for new (rule, env, site, playbook) tuples.
# Values: "suggest_only" | "approve_each" | "auto_with_notification" | "auto_silent"
[remediation.defaults]
home_lab     = "auto_with_notification"
data_center  = "approve_each"
service_provider = "approve_each"
campus_wired = "approve_each"
campus_wireless = "approve_each"

# Per-rule overrides (inherits from defaults when unset):
# [remediation.rule_defaults.bgp_session_down]
# data_center = "auto_with_notification"

# ── [integrations] ───────────────────────────────────────────────────────────

[integrations.servicenow]
# Enable ServiceNow integration. Requires instance_url + credential_alias.
enabled = false

# PDI or production instance URL. Example: "https://dev12345.service-now.com"
instance_url = ""

# Vault alias for ServiceNow credentials (username + password).
credential_alias = ""

# Push detection events to ServiceNow Event Management.
em_push_enabled = false

[integrations.servicenow.event_filter]
# Minimum event severity to push: "critical" | "warning" | "info". Default: "warning"
min_severity = "warning"

# Hold detections this many seconds before pushing (avoid noise from flaps). Default: 60
min_age_secs = 60

# Suppress a (device, rule_id) pair that was already pushed within this window. Default: 300
dedup_window_secs = 300

[integrations.servicenow.aiops]
# Enable Sprint 6 incident sync and playbook bridge (ServiceNow AIOps).
enabled = false

# Background sync cadence (seconds). Default: 120
poll_interval_secs = 120

# Detections newer than this window are treated as active incidents. Default: 900
active_window_secs = 900

# Time window to correlate detections into one incident. Default: 30
correlation_window_secs = 30

# ServiceNow table name for ITSM incidents. Default: "incident"
incident_table = "incident"

# State value for open incidents. Default: "1" (New)
open_state = "1"

# State value when bonsai auto-resolves. Default: "6" (Resolved)
resolved_state = "6"

# Max physical hop depth for blast-radius context attached to incidents. Default: 2
max_blast_radius_hops = 2

# Resolve previously-synced incidents when detections go quiet. Default: true
auto_clear = true

# Parse ServiceNow comments for `bonsai:playbook <id>` commands. Default: true
playbook_bridge_enabled = true

# Optional fallback assignment group name/sys_id when CMDB has no group for the device.
# assignment_group_fallback = ""

# ── [signals] ────────────────────────────────────────────────────────────────

[signals.syslog]
# Enable the syslog receiver for structured event parsing from network devices.
enabled = false

# UDP listen address. Use "0.0.0.0:514" for deployment (requires root/cap_net_bind).
# Default avoids privileged ports for dev.
udp_addr = "0.0.0.0:5514"

# TCP listen address for syslog over TCP (RFC 3195).
tcp_addr = "0.0.0.0:6514"

# JSONL archive path for raw + parsed syslog records.
archive_path = "runtime/signals/syslog.jsonl"

# Maximum accepted syslog frame size in bytes. Default: 8192
max_frame_bytes = 8192

[signals.snmp]
# Enable the SNMP trap receiver (v1/v2c/v3).
enabled = false

# UDP listen address. Use "0.0.0.0:162" for deployment (requires root/cap_net_bind).
udp_addr = "0.0.0.0:9162"

# JSONL archive path for raw SNMP trap records.
archive_path = "runtime/signals/snmp.jsonl"

# Maximum accepted trap size in bytes. Default: 8192
max_frame_bytes = 8192

# Optional community string allowlist (v1/v2c). Empty = accept all.
# community_allowlist = ["public", "monitoring"]

# SNMPv3 USM users. If any are configured, v3 traps from unknown users are dropped.
# Keys are read from environment variables — never put key material in this file.
# [[signals.snmp.v3_users]]
# security_name = "bonsaimon"
# auth_protocol = "sha"           # md5 | sha | sha256 | sha512
# auth_key_env  = "SNMP_AUTH_KEY_BONSAIMON"
# priv_protocol = "aes128"        # des | aes128 | aes256
# priv_key_env  = "SNMP_PRIV_KEY_BONSAIMON"

# ── [streaming] ──────────────────────────────────────────────────────────────

[streaming.bmp]
# Enable BMP (BGP Monitoring Protocol) receiver. Listens for BMP sessions from routers.
enabled = false
tcp_addr = "0.0.0.0:5000"
archive_path = "runtime/streaming/bmp.jsonl"
max_frame_bytes = 65535

[streaming.bgp_ls]
# Enable BGP-LS receiver (via GoBGP sidecar).
# Receives line-delimited JSON events from the gobgp-bgp-ls Docker sidecar.
enabled = false
tcp_addr = "127.0.0.1:15071"
archive_path = "runtime/streaming/bgp_ls.jsonl"
max_frame_bytes = 65535

[streaming.pcep]
# Enable PCEP (Path Computation Element Protocol) receiver.
enabled = false
tcp_addr = "0.0.0.0:4189"
archive_path = "runtime/streaming/pcep.jsonl"
max_frame_bytes = 65535

[streaming.otlp]
# Enable OpenTelemetry Protocol (OTLP) HTTP receiver.
enabled = false
http_addr = "0.0.0.0:4318"

[streaming.netflow]
# Enable NetFlow/IPFIX UDP receiver.
enabled = false
udp_addr = "0.0.0.0:2055"

[streaming.sflow]
# Enable sFlow v5 UDP receiver (RFC 3176). Default port 6343.
enabled = false
udp_addr = "0.0.0.0:6343"

# ── [gnn] ────────────────────────────────────────────────────────────────────

[gnn]
# GNN inference mode:
#   "calibration" — anomaly scores accumulate in gnn_calibration_scores but
#                   no Detection rows are written. Use for the first 7–30 days.
#   "production"  — scores above threshold produce Detection rows.
# Do not switch to "production" before reviewing the calibration score distribution.
# Default: "calibration"
inference_mode = "calibration"

# Anomaly score threshold for production mode. Scores above this trigger a Detection.
# Review calibration P95 before adjusting. Default: 0.5
threshold = 0.5

# Advisory minimum number of calibration-phase samples before transitioning to production.
# Bonsai does not block the transition — this is informational only. Default: 1000
min_calibration_samples = 1000

# ── [logging] ────────────────────────────────────────────────────────────────

[logging]
# Log level: "error" | "warn" | "info" | "debug" | "trace". Default: "info"
level = "info"

# Path for the rotating log file. When empty, logs go to stderr only.
# Default: "" (stderr only)
file_path = ""

# Log rotation period: "daily" | "hourly" | "never". Default: "daily"
rotation = "daily"

# Number of rotated log files to retain. Default: 7
retention_days = 7

# Minimum free disk bytes at the log file path required to start bonsai.
# 0 = skip the check. Default: 5368709120 (5 GiB)
min_free_bytes = 5368709120

# Per-module log level overrides (takes precedence over `level`).
# [logging.targets]
# "bonsai::ingest" = "debug"
# "bonsai::enrichment" = "debug"

# ── [lab] ────────────────────────────────────────────────────────────────────

[lab]
# Active lab topology identifier. Used by scripts to select the correct
# ContainerLab topology file. Valid values: "dc" | "sp" | "fast-iteration" | "cloud-dc"
# Omit the entire [lab] section for non-lab (production) deployments.
topology = ""

# IPv4 management subnet for the active ContainerLab topology.
# ContainerLab invariant: the Docker network is always named "bonsai-mgmt".
# Example: "172.100.103.0/24"
mgmt_subnet = ""

# IPv6 management subnet. Example: "2001:db8:103::/64"
mgmt_ipv6_subnet = ""

# ── [assignment] ─────────────────────────────────────────────────────────────

# Collector assignment rules for distributed deployments.
# When a device has no explicit collector_id, these rules are evaluated in
# descending priority order. Omit this section for single-collector setups.
#
# [[assignment.rules]]
# match_site = "site-a"
# match_role = "leaf"       # optional; omit to match any role
# collector_id = "site-a-collector-1"
# priority = 10

# ── [ha] ────────────────────────────────────────────────────────────────────────
#
# High Availability (HA) configuration for distributed multi-node deployments.
# When enabled, multiple bonsai core instances coordinate via etcd for leader
# election and config replication. Only the leader accepts collector registrations.
# Omit this section for single-node (standalone) deployments.

[ha]
# HA mode: "standalone" or "cluster".
#   "standalone" — single node, no leader election (default)
#   "cluster"    — multi-node with etcd-based leader election and config replication
# Default: "standalone"
# Also controlled by BONSAI_HA_MODE environment variable.
mode = "standalone"

# Unique identifier for this node in the cluster.
# Must be unique across all nodes (e.g., "node-1", "site-a-core-1").
# Default: "node-1"
# Also controlled by BONSAI_NODE_ID environment variable.
node_id = "node-1"

# [ha.etcd] — etcd configuration for leader election and config storage.
[ha.etcd]
# Comma-separated list of etcd endpoint URLs.
# Example: "http://etcd-1:2379,http://etcd-2:2379,http://etcd-3:2379"
# Default: "http://127.0.0.1:2379"
# Also controlled by BONSAI_ETCD_ENDPOINTS environment variable.
endpoints = "http://127.0.0.1:2379"

# Leader election lease TTL in seconds.
# If the leader fails to renew within this window, a new election is triggered.
# Lower values = faster failover but more etcd traffic.
# Default: 10
# Also controlled by BONSAI_ETCD_ELECTION_TTL environment variable.
election_ttl_secs = 10

# etcd key prefix for config replication.
# Config changes are stored under this prefix (e.g., /bonsai/config/devices/...).
# Default: "/bonsai/config"
# Also controlled by BONSAI_ETCD_CONFIG_PREFIX environment variable.
config_prefix = "/bonsai/config"

# ── [ai] — AI Investigation Engine ───────────────────────────────────────────
#
# Bonsai can autonomously investigate unmatched detections using a large
# language model with access to graph query tools (via the MCP server).
# Both Gemini (Google) and Moonshot (OpenAI-compatible) are supported.
#
# Investigations are only launched when the API key env var is present.
# Use `POST /api/ai/test` to verify the connection before enabling.
#
# Cost safety:
#   - per_investigation_budget_usd: hard cap per single investigation run
#   - daily_budget_usd: total spend cap across all investigations today
#   Set both conservatively; increase after observing token usage.

[ai]
# AI provider backend.
# Supported values: "gemini" | "moonshot"
# Default: "gemini"
# provider = "gemini"

# Model name for the selected provider.
# Gemini examples:  "gemini-2.5-pro" | "gemini-2.0-flash"
# Moonshot examples: "moonshot-v1-8k" | "moonshot-v1-32k" | "moonshot-v1-128k"
# Default: "gemini-2.5-pro"
# model = "gemini-2.5-pro"

# Name of the environment variable that holds the API key.
# For Gemini: set BONSAI_AI_API_KEY to your Google AI Studio key.
# For Moonshot: set BONSAI_AI_API_KEY to your Moonshot API key.
# If the variable is not set, AI investigations are disabled (no error on start).
# Default: "BONSAI_AI_API_KEY"
# api_key_env = "BONSAI_AI_API_KEY"

# Maximum cost (USD) allowed for a single investigation run.
# The run is aborted early if this threshold is reached.
# Default: 0.10
# per_investigation_budget_usd = 0.10

# Maximum total AI spend (USD) across all investigations started today (UTC).
# New investigations are skipped (status = "skipped") if the daily total
# equals or exceeds this value.
# Default: 1.00
# daily_budget_usd = 1.00

# When true, bonsai automatically spawns an AI investigation for every
# DetectionEvent whose rule_id has no matching playbook in the library.
# Requires a valid API key. Start with false until you've observed
# playbook coverage and trust the auto-propose path.
# Default: false
# auto_investigate_unmatched = false

# ── [[target]] ───────────────────────────────────────────────────────────────
#
# One [[target]] block per managed network device.
# Devices can also be added at runtime via the UI or POST /api/devices.
# Static targets here are merged with runtime-managed devices on startup.
#
# Minimal example (no TLS, inline credentials — lab only):
# [[target]]
# address  = "192.0.2.1:57400"
# hostname = "router-1"
# username = "admin"
# password = "secret"
#
# Production example (TLS + vault credentials):
# [[target]]
# address          = "10.0.1.1:57400"
# hostname         = "leaf-01"
# role             = "leaf"          # leaf | spine | pe | p | rr | core | distribution | access
# site             = "dc-east"
# tls_domain       = "leaf-01.mgmt.example.com"    # SNI name on the device certificate
# ca_cert          = "config/tls/ca.pem"            # PEM CA that signed the device cert
# credential_alias = "dc-east-gnmi"                 # vault alias (added via UI or CLI)
# collector_id     = "site-a-collector-1"           # omit for single-collector setups
#
# ── Authentication / LDAP ────────────────────────────────────────────────────
#
# RBAC is enforced when BONSAI_REQUIRE_AUTH=1 env var is set.
# Bootstrap admin: set BONSAI_ADMIN_USER and BONSAI_ADMIN_PASS env vars.
#
# [auth.ldap]
# enabled             = true
# server_url          = "ldap://ldap.example.com:389"
# bind_dn             = "CN=svc-bonsai,OU=Service Accounts,DC=example,DC=com"
# bind_password_env   = "BONSAI_LDAP_BIND_PASSWORD"
# user_search_base    = "OU=Users,DC=example,DC=com"
# user_search_filter  = "(&(objectClass=person)(sAMAccountName={username}))"
# group_search_base   = "OU=Groups,DC=example,DC=com"
# default_role        = "viewer"
# tls_skip_verify     = false
#
# [auth.ldap.role_mapping]
# "Network Admins" = "admin"
# "NOC"            = "operator"
# "Viewers"        = "viewer"

# Env-var credentials (useful for CI / container deployments):
# [[target]]
# address      = "10.0.1.2:57400"
# hostname     = "leaf-02"
# username_env = "DEVICE_USERNAME"   # reads from $DEVICE_USERNAME
# password_env = "DEVICE_PASSWORD"
#
# Subscription path override (normally auto-selected during onboarding discovery):
# [[target.selected_paths]]
# path               = "/interface[name=*]/statistics"
# mode               = "SAMPLE"
# sample_interval_ns = 10000000000   # 10 seconds in nanoseconds
# rationale          = "interface counters"
# optional           = false
