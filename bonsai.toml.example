# bonsai.toml — runtime configuration
# Copy to bonsai.toml, fill in credentials, keep out of git (it is gitignored).
# Never commit credentials.
#
# Phase 4 lab: bonsai-p4 (3x SRL + 1x XRd, mgmt 172.100.102.x)
# Run lab/fast-iteration/deploy-p4.sh to generate p4-ca.pem and bring up nodes.

graph_path   = "bonsai.db"

# ── GNN inference mode (D5-T4 DV1) ───────────────────────────────────────────
# During calibration (default), GNN scores accumulate in gnn_calibration_scores
# but no Detection rows are created. Review the 7-day score distribution, then
# flip to production.
# [gnn]
# inference_mode = "calibration"   # "calibration" | "production"
# threshold = 0.5                  # anomaly score threshold (production only)
# min_calibration_samples = 1000   # advisory minimum before switching to prod
# Runtime mode (T1-2 distributed collector seam)
# [runtime]
# mode = "all"  # one of: all, core, collector
# resource_profile = "large"  # optional override: tiny|small|medium|large|xlarge
# collector_id = "local"
# core_ingest_endpoint = "http://[::1]:50051"  # used only by collector mode
# [runtime.tls]
# enabled = false
# ca_cert = "config/tls/ca.pem"
# cert = "config/tls/core.pem"       # core cert in core/all mode; collector cert in collector mode
# key = "config/tls/core-key.pem"
# server_name = "bonsai-core.local"  # collector-side verification name; must match core SAN
#
# all: current single-process behavior; subscribes to devices and runs graph/API/UI.
# core: graph/API/UI plus TelemetryIngest server; no local gNMI subscribers.
# collector: local gNMI subscribers plus optional collector-local archive; forwards
# decoded telemetry to the core ingest endpoint.
# api_addr     = "[::1]:50051"   # gRPC API (default shown)
# metrics_addr = "[::1]:9090"    # Prometheus /metrics HTTP (set to "" to disable)
#
# [collector.queue]
# path = "runtime/collector-queue"
# max_bytes = 1073741824       # 1 GiB; oldest unacked records are dropped above this
# max_age_hours = 24           # 0 disables age-based drops
# drain_batch_size = 1000      # records per reconnect replay stream
# log_interval_seconds = 30    # periodic queue size visibility; 0 disables

# Local credential vault (T1-1). Set BONSAI_VAULT_PASSPHRASE before starting
# Bonsai to unlock alias-based credentials. Secrets are encrypted in vault.age;
# metadata.json stores alias names and timestamps only.
# [credentials]
# path = "bonsai-credentials"
# passphrase_env = "BONSAI_VAULT_PASSPHRASE"

# ── Layered ingestion (CV1 Sprint 2 baseline) ───────────────────────────────
# Encrypted-at-rest config snapshots captured via gNMI Get(CONFIG). Manual
# re-parse is available from the device drawer; a weekly scheduled verification
# queue runs automatically when enabled.
# [layered_ingestion]
# enabled = true
# config_store_path = "runtime/config-store"
# config_store_passphrase_env = "BONSAI_VAULT_PASSPHRASE"
# change_detection_schedule_interval_secs = 3600
# change_detection_reparse_interval_secs = 604800
# history_limit = 25
# default_gnmi_get_paths = []   # empty means "request the full config tree"
# gnmi_known_issues_path = "config/gnmi_known_issues/default.yaml"
# syslog_patterns_path = "config/syslog_patterns"
#
# [layered_ingestion.parser_chain]
# consensus_mode = false
# CLI capture uses `scripts/cli_capture.py` plus Paramiko from the repo-local
# Python environment. When `target.vendor` is absent, Bonsai falls back to
# hostname inference (`xrd-*`, `srl-*`, `ceos-*`, `crpd-*`, `vjunos-*`, `frr-*`).
# priorities."cisco-iosxr::show bgp summary" = ["pyats_genie", "ntc_templates", "bonsai_native"]
# priorities."cisco-iosxr::show bgp neighbors" = ["pyats_genie", "ntc_templates", "bonsai_native"]
# priorities."cisco-nxos::*" = ["pyats_genie", "suzieq_native", "ntc_templates"]
# priorities."arista-eos::*" = ["suzieq_native", "pyats_genie", "ntc_templates"]
# priorities."juniper-junos::*" = ["pyats_genie", "ntc_templates", "bonsai_native"]
# priorities."nokia-srlinux::*" = ["bonsai_native"]
# priorities."frr::*" = ["bonsai_native"]
#
# [layered_ingestion.parser_chain.sidecars]
# pyats_url = "http://127.0.0.1:9101"
# native_url = "http://127.0.0.1:9102"

# ── YANG library lifecycle (CV1 Sprint 4) ───────────────────────────────────
# The local YANG catalogue stores imported/synced modules and the Bonsai path
# index derived from them. Signed bundle workflows use a shared secret key env
# var so internet-connected workstations can prepare bundles for restricted
# environments.
# [yang]
# library_root = "runtime/yang_catalogue"
# cache_root = "runtime/yang_cache"
# bundle_key_env = "BONSAI_YANG_BUNDLE_KEY"

# ── Graph database (v12 T0-1) ─────────────────────────────────────────────────
# LadybugDB buffer pool is capped by default to avoid the ~80% RAM grab.
# Default: min(2 GiB, 25% of RAM) for core; min(256 MiB, 10%) for collector.
# Override here if you have more RAM to spare or run on a constrained device.
# [graph]
# buffer_pool_bytes = 536870912    # 512 MiB default; fits within 1.5 GiB RSS budget for 8-12 node labs

# ── Event bus (T1-1) ──────────────────────────────────────────────────────────
# [event_bus]
# capacity              = 512    # broadcast channel depth; default reduced from 2048 in v12
# counter_debounce_secs = 10     # min interval between interface counter graph writes
# [archive]
# enabled                = true     # write telemetry updates to parquet for cold storage
# path                   = "archive"
# flush_interval_seconds = 10
# max_batch_rows         = 1000
# compression_level      = 12        # ZSTD level 1-22 (default 12; level 22 not worth CPU cost)
# writer_max_idle_secs   = 7200      # force-close partition writers idle for >2h (prevents open-file leaks)
# max_file_age_seconds   = 3600      # force-rotate writers after 1h wall-clock age (ensures closed files appear even during continuous ingest)

# ── Signals (BV6) ────────────────────────────────────────────────────────────
# Syslog is disabled by default. The sample UDP port avoids root privileges for
# local development; deployments can use 0.0.0.0:514 and TCP 6514.
# [signals.syslog]
# enabled          = false
# udp_addr         = "0.0.0.0:5514"
# tcp_addr         = "0.0.0.0:6514"
# archive_path     = "runtime/signals/syslog.jsonl"
# max_frame_bytes  = 8192
#
# SNMP trap receiver uses an unprivileged default port for development.
# Real deployments can bind 0.0.0.0:162 if the process has permission.
# [signals.snmp]
# enabled          = false
# udp_addr         = "0.0.0.0:9162"
# archive_path     = "runtime/signals/snmp.jsonl"
# max_frame_bytes  = 8192

# ── Modern streaming protocols (CV2 Sprint 4) ───────────────────────────────
# BMP is a native TCP receiver in bonsai-core. Devices export BMP directly to
# the collector using RFC 7854. This is the preferred standards-based path for
# per-prefix BGP visibility in mixed-vendor networks.
# [streaming.bmp]
# enabled          = false
# tcp_addr         = "0.0.0.0:5000"
# archive_path     = "runtime/streaming/bmp.jsonl"
# max_frame_bytes  = 65535
#
# BGP-LS is ingested through a GoBGP-style sidecar that forwards normalized
# JSON lines to Bonsai. The contract is intentionally vendor-neutral even though
# the sidecar itself may be fed by vendor-specific control-plane sessions.
# [streaming.bgp_ls]
# enabled          = false
# tcp_addr         = "127.0.0.1:15071"
# archive_path     = "runtime/streaming/bgp_ls.jsonl"
# max_frame_bytes  = 65535
#
# PCEP remains deferred until the SP lab is validated. The config section exists
# now so the readiness report can describe the future seam without claiming the
# runtime parser is already complete.
# [streaming.pcep]
# enabled          = false
# tcp_addr         = "0.0.0.0:4189"
# archive_path     = "runtime/streaming/pcep.jsonl"
# max_frame_bytes  = 65535

# ── Retention (v11 T4-3) ─────────────────────────────────────────────────────
# Enabled by default to bound graph memory and WAL size.
# [retention]
# enabled                  = true    # enable hourly prune pass (default: true)
# max_age_hours            = 24      # delete events older than N hours (default: 24)
# max_state_change_events  = 10000   # hard cap on total events; 0 = unlimited (default: 10000)

# ── Storage caps (v11 T4-5) ──────────────────────────────────────────────────
# [storage]
# max_archive_bytes     = 10737418240   # 10 GB archive cap (0 = unlimited)
# max_graph_bytes       = 5368709120    # 5 GB graph cap (0 = unlimited)
# check_interval_secs   = 300           # how often to check disk usage
# warn_threshold_pct    = 80            # warn when usage reaches this % of cap

# ── ServiceNow integration (T2-1) ─────────────────────────────────────────────
# Primary dev/test target: your reserved PDI (https://devXXXXXX.service-now.com).
# Production deployments: use scoped roles (itil + event_creator), NOT admin creds.
# Credential is stored in the vault under `credential_alias` — NEVER inline here.
#
# [integrations.servicenow]
# enabled           = false
# instance_url      = "https://devXXXXXX.service-now.com"
# credential_alias  = "servicenow-pdi"   # set with: bonsai credentials set servicenow-pdi
# em_push_enabled   = false              # push DetectionEvents to Event Management
#
# [integrations.servicenow.event_filter]
# min_severity       = "warning"   # "critical" | "warning" | "info"
# min_age_secs       = 60          # only push detections older than N seconds (debounce transients)
# dedup_window_secs  = 300         # suppress same (device, rule) re-push within N seconds
#
# [integrations.servicenow.aiops]
# enabled                    = false
# poll_interval_secs         = 120
# active_window_secs         = 900
# correlation_window_secs    = 30
# incident_table             = "incident"
# open_state                 = "1"   # ServiceNow "New"
# resolved_state             = "6"   # ServiceNow "Resolved"
# assignment_group_fallback  = ""
# max_blast_radius_hops      = 2
# auto_clear                 = true
# playbook_bridge_enabled    = true

# ── Human-in-the-loop remediation trust (Sprint 4) ────────────────────────────
# [remediation]
# rollback_window_secs = 60
#
# [remediation.graduation]
# consecutive_approvals_required = 10
#
# [remediation.defaults]
# home_lab         = "auto_silent"
# data_center      = "auto_with_notification"
# service_provider = "approve_each"
# campus_wired     = "auto_with_notification"
# campus_wireless  = "approve_each"
#
# Optional per-rule overrides. Unspecified archetypes inherit the global default.
# [remediation.rule_defaults.bgp_session_down]
# data_center      = "approve_each"
# service_provider = "approve_each"

# ── Lab management network (CV5 T2-3) ───────────────────────────────────────
# Declares the active lab's management subnet as an explicit config key.
# Scripts and tooling read this instead of inferring it from device addresses.
# Invariant: network name is always "bonsai-mgmt"; only the subnet changes per lab.
#
# [lab]
# topology       = "dc"                  # dc | sp | fast-iteration | cloud-dc
# mgmt_subnet    = "172.100.103.0/24"    # IPv4 mgmt subnet for the active lab
# mgmt_ipv6_subnet = "2001:db8:103::/64" # IPv6 mgmt subnet for the active lab

# ── Nokia SR Linux — spine (TLS) ─────────────────────────────────────────────
[[target]]
address    = "172.100.102.11:57400"
hostname   = "srl-spine1"
tls_domain = "clab-bonsai-p4-srl-spine1"
ca_cert    = "lab/fast-iteration/p4-ca.pem"
# credential_alias = "srl-lab-admin"  # preferred once added via /api/credentials
username   = "admin"
password   = "NokiaSrl1!"

# ── Nokia SR Linux — leaf1 (TLS) ─────────────────────────────────────────────
[[target]]
address    = "172.100.102.12:57400"
hostname   = "srl-leaf1"
tls_domain = "clab-bonsai-p4-srl-leaf1"
ca_cert    = "lab/fast-iteration/p4-ca.pem"
username   = "admin"
password   = "NokiaSrl1!"

# ── Nokia SR Linux — leaf2 (TLS) ─────────────────────────────────────────────
[[target]]
address    = "172.100.102.13:57400"
hostname   = "srl-leaf2"
tls_domain = "clab-bonsai-p4-srl-leaf2"
ca_cert    = "lab/fast-iteration/p4-ca.pem"
username   = "admin"
password   = "NokiaSrl1!"

# ── Cisco IOS-XRd — PE (no TLS) ──────────────────────────────────────────────
[[target]]
address  = "172.100.102.21:57400"
hostname = "xrd-pe1"
username = "cisco"
password = "cisco123!"
