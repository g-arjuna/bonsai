# bonsai.toml — minimal bootstrap configuration
#
# Copy to bonsai.toml and edit before starting bonsai.
# Only bootstrap settings belong here — runtime tunables are managed via
# the DB-backed settings API:
#   GET  /api/settings               — list all config sections
#   GET  /api/settings/{section}     — read a section
#   PATCH /api/settings/{section}    — write a section
#   POST /api/settings/export        — dump all DB-stored config
#
# On first boot, YAML files under config/ are migrated into the ConfigItem
# database. Subsequent changes via the API or UI are persisted to DB and
# override these TOML defaults.
#
# Quick start:
#   cp bonsai.toml.example bonsai.toml
#   export BONSAI_VAULT_PASSPHRASE="your-passphrase"
#   ./bonsai

# ── Bootstrap (required) ────────────────────────────────────────────────────

graph_path = "runtime/bonsai.db"

[runtime]
mode = "all"                         # "all" | "core" | "collector"
# collector_id = "local"             # unique name in distributed setups
# core_ingest_endpoint = "http://[::1]:50051"   # only for mode="collector"

[credentials]
path = "bonsai-credentials"
passphrase_env = "BONSAI_VAULT_PASSPHRASE"

# ── Listen addresses (require restart) ──────────────────────────────────────
# Uncomment to override defaults:
# http_addr    = "0.0.0.0:3000"
# api_addr     = "[::1]:50051"
# metrics_addr = "[::1]:9090"

# ── Devices ─────────────────────────────────────────────────────────────────
# Prefer adding devices via UI or POST /api/devices at runtime.
# Static [[target]] blocks are merged with runtime devices on startup.
#
# [[target]]
# address          = "10.0.1.1:57400"
# hostname         = "leaf-01"
# role             = "leaf"
# site             = "dc-east"
# credential_alias = "dc-east-gnmi"    # vault alias

# ── Optional bootstrap overrides ────────────────────────────────────────────
# These sections provide TOML defaults for first boot.
# Once a section is saved via PATCH /api/settings/{section}, the DB value
# takes precedence and this TOML block is ignored for that section.
#
# [ha]
# mode = "standalone"
# node_id = "node-1"
# [ha.etcd]
# endpoints = "http://127.0.0.1:2379"
#
# [runtime.tls]
# enabled = true
# ca_cert = "config/tls/ca.pem"
# cert    = "config/tls/collector.pem"
# key     = "config/tls/collector-key.pem"
# server_name = "bonsai-core.local"
