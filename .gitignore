/target

# macOS Finder droppings — never commit
.DS_Store
**/.DS_Store

# Bonpy SPA build artefacts (built by CI; checked out by Ubuntu)
ui-bonpy/node_modules/
ui-bonpy/dist/
ui-bonpy/dist-bonpy/
# SvelteKit route files must never be gitignored (+ prefix is a SvelteKit convention)
!ui-bonpy/src/routes/**/+*.svelte
!ui-bonpy/src/routes/**/+*.js
!ui-bonpy/src/routes/**/+*.ts

# Runtime config — contains credentials, never commit
bonsai.toml
bonsai-core.toml
bonsai-collector.toml

# LadybugDB graph database files
bonsai.db
bonsai.db.wal
bonsai-mv.db
bonsai-mv.db.wal
bonsai-core.db
bonsai-core.db.wal
bonsai-collector.db
bonsai-collector.db.wal
bonsai-registry.json
bonsai-credentials/

# ContainerLab runtime directories (TLS certs, node configs, topology state)
lab/**/clab-*

# Generated protobuf — work from .proto sources, not generated output
src/proto/

# ContainerLab CA certs (generated per deployment, not committed)
lab/fast-iteration/ca.pem
lab/fast-iteration/mv-ca.pem

# Compose mTLS certs — generated by scripts/generate_compose_tls.sh, never committed
docker/tls/

# Compose local env overrides — contains vault passphrase
.env

# OCI cloud spike live resource state — contains instance/volume OCIDs and IPs
scripts/cloud/instance.env

# gNMI probe credentials (copy from gnmi-creds.sh.example)
lab/tools/gnmi-creds.sh

# ContainerLab p4 CA cert (generated per deployment)
lab/fast-iteration/p4-ca.pem

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Trained ML model binaries (large, runtime-generated — train locally)
python/models/
models/

# Training data exports (large Parquet files, runtime-generated)
data/
archive/
archive_smoke*/
chaos_runs/

# Svelte UI build output and dependencies (reproducible from source)
ui/dist/
ui/node_modules/

# Debug / run logs
*.log
# Exception: validation script's side-channel logs MUST be tracked so the
# Mac↔Ubuntu iteration loop can see Ubuntu's build/test/inject output.
# Without this, `*.log` would silently drop the diagnostic logs the validation
# script captures into docs/test_results/cv7-validation-*.logs/.
!docs/test_results/**/*.log
runtime/

# Claude Code session memory (local tooling state, not project content)
.claude/
ui/.vscode/

# YANG discovery — generated artefacts (large, gitignored by discipline)
.yang-cache/
discovered_paths/

# graphify knowledge graph (generated artefact, rebuilt from source)
graphify-out/

# UI test driver dependencies and generated files
tests/ui_driver/node_modules/
tests/ui_driver/package-lock.json

# Lab DC CA cert (generated per clab deployment)
lab/dc/ca.pem

# Python test coverage
python/.coverage
.coverage

# Historical backlog versions and prompt/tooling artifacts (kept locally, not public)
BONSAI_CONSOLIDATED_BACKLOG_V*.md
BONSAI_CONSOLIDATED_BACKLOG_CV*.md
BONSAI_CONSOLIDATED_BACKLOG_BV1.md
BONSAI_CONSOLIDATED_BACKLOG_BV2.md
BONSAI_CONSOLIDATED_BACKLOG_BV2_MOD.md
BACKLOG_V2_EXECUTION_LOG.md
CLAUDE_CODE_RESUME_PROMPT.md
CODEX_HARVEST_RESUME_PROMPT.md
PHASE4.md
PHASE5_*.md

# CV5 freeze dirs — contain bonsai.toml.snapshot which may have credentials
pre_cv5_freeze_*/

# Older freeze snapshots may also contain local graph DB state
pre_cv2_freeze_*/bonsai.db*
pre_cv2_freeze_*/bonsai.db.wal*
pre_cv2_freeze_*/local_runtime.tgz
