+def parse_tlvs(body: bytes) -> list[tuple[int, bytes]]:
+    """Parse sequential (type: u16, len: u16, value) TLVs requiring exact body consumption."""
+    pos = 0
+    out: list[tuple[int, bytes]] = []
+    while pos < len(body):
+        assert pos + 4 <= len(body), "Truncated TLV header"
+        tlv_type, tlv_len = struct.unpack("!HH", body[pos : pos + 4])
+        pos += 4
+        assert pos + tlv_len <= len(body), "Truncated TLV value"
+        out.append((tlv_type, body[pos : pos + tlv_len]))
+        pos += tlv_len
+    return out
+
