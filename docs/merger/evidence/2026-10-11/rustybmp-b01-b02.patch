diff --git a/scripts/run_required_tests.py b/scripts/run_required_tests.py
new file mode 100644
index 0000000..9bf1bb3
--- /dev/null
+++ b/scripts/run_required_tests.py
@@ -0,0 +1,37 @@
+"""Run required pytest suites: missing tests, failures and skips cannot pass CI.
+
+Run from the repository root, for example:
+    python3 scripts/run_required_tests.py tests/protocol/ tests/ml/ -q
+Local optional/lab suites may still use pytest directly.
+"""
+
+from pathlib import Path
+import sys
+
+import pytest
+
+
+class RequiredSuite:
+    def __init__(self):
+        self.skipped = 0
+
+    def pytest_runtest_logreport(self, report):
+        if report.skipped:
+            self.skipped += 1
+
+    def pytest_collectreport(self, report):
+        # importorskip can hide an entire module alongside other passing tests.
+        if report.skipped:
+            self.skipped += 1
+
+    def pytest_sessionfinish(self, session, exitstatus):
+        if self.skipped:
+            print(f"\nRequired suite rejected {self.skipped} skipped test report(s).")
+            if exitstatus == pytest.ExitCode.OK:
+                session.exitstatus = pytest.ExitCode.TESTS_FAILED
+
+
+if __name__ == "__main__":
+    # Match `python -m pytest` imports even though this launcher lives in scripts/.
+    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
+    raise SystemExit(pytest.main(sys.argv[1:], plugins=[RequiredSuite()]))
