+
+/// Accept a TLS handshake with an explicit deadline so stalled clients cannot block tasks.
+pub async fn accept_with_timeout(
+    acceptor: &TlsAcceptor,
+    stream: TcpStream,
+    timeout: Duration,
+) -> Result<TlsStream<TcpStream>> {
+    match tokio::time::timeout(timeout, acceptor.accept(stream)).await {
+        Ok(res) => res.context("TLS handshake failed"),
+        Err(_) => bail!("TLS handshake timed out after {}ms", timeout.as_millis()),
+    }
 }
