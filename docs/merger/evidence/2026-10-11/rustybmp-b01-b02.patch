+# Bounded readiness check. A missing backend is a failure, never a skip.
+set -euo pipefail
+url="${1:?usage: wait_http.sh URL [timeout_seconds]}"
+timeout_seconds="${2:-60}"
+[[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] || { echo "Invalid timeout" >&2; exit 2; }
+deadline=$((SECONDS + timeout_seconds))
+while (( SECONDS < deadline )); do
+    if curl --fail --silent --max-time 2 "$url" >/dev/null; then
+        exit 0
+    fi
+    sleep 0.5
+done
+echo "Readiness timed out after ${timeout_seconds}s: $url" >&2
+exit 1
