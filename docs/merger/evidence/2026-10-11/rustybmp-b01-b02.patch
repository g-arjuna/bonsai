+            let mut hdr = vec![3u8];
+            hdr.extend_from_slice(&bad_len.to_be_bytes());
+            hdr.push(4);
+            client.write_all(&hdr).await.unwrap();
+
+            let (tx, _rx) = mpsc::channel(8);
+            let gov = ResourceGovernor::new(GovernorConfig::default());
+            let archive = Arc::new(BmpArchive::open(None).await.unwrap());
+            let cancel = CancellationToken::new();
+
+            let res = tokio::time::timeout(
+                Duration::from_millis(200),
+                handle_connection_stream(
+                    server,
+                    "192.0.2.10:12345".parse().unwrap(),
+                    test_cfg(1024, 100),
+                    cancel,
+                    tx,
+                    gov,
+                    archive,
+                ),
+            )
+            .await
+            .expect("receiver must not spin or hang on zero/short frame length");
+            assert!(res.is_err(), "expected framing error for length {bad_len}");
+        }
+    }
+
+    #[tokio::test]
+    async fn oversized_declared_length_is_rejected_immediately_at_header() {
+        // Client writes ONLY the 6-byte header claiming 4 GiB and keeps the stream open.
+        // Receiver must reject immediately upon reading the 6-byte header without waiting for body bytes.
+        let (mut client, server) = tokio::io::duplex(256);
+        client
+            .write_all(&[3, 0xFF, 0xFF, 0xFF, 0xFF, 4])
+            .await
+            .unwrap();
