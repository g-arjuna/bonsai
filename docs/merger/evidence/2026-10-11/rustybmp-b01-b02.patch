+    fn valid_initiation_frame(name: &str) -> Vec<u8> {
+        let name_bytes = name.as_bytes();
+        let total_len = (6 + 4 + name_bytes.len()) as u32;
+        let mut frame = Vec::with_capacity(total_len as usize);
+        frame.push(3);
+        frame.extend_from_slice(&total_len.to_be_bytes());
+        frame.push(4); // Initiation
+        frame.extend_from_slice(&2u16.to_be_bytes()); // TLV 2 = sysName
+        frame.extend_from_slice(&(name_bytes.len() as u16).to_be_bytes());
+        frame.extend_from_slice(name_bytes);
+        frame
+    }
+
+    #[tokio::test]
