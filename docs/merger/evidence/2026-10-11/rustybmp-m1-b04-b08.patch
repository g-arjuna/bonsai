         }
     }
     if let Err(e) = conn.execute_batch("COMMIT") {
         error!("DuckDB COMMIT failed: {e}");
         let _ = conn.execute_batch("ROLLBACK");
+        return Err(e.into());
     }
+    Ok(batch.len())
 }
 
