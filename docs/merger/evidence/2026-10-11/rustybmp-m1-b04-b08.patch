+        let hdr_vrf_a = peer_hdr(peer_ip, PeerType::RdInstance, rd_vrf_a, RibType::AdjRibInPrePolicy);
+        let hdr_vrf_b = peer_hdr(peer_ip, PeerType::RdInstance, rd_vrf_b, RibType::AdjRibInPrePolicy);
