+    #[test]
+    fn b04_same_peer_on_two_exporters_remains_isolated_across_peer_down_and_termination() {
+        let (mut mgr, _rx) = RibManager::new(128);
+        let exporter_a: IpAddr = "10.0.0.1".parse().unwrap();
+        let exporter_b: IpAddr = "10.0.0.2".parse().unwrap();
+        let peer_ip: IpAddr = "192.0.2.1".parse().unwrap();
+        let pfx = Prefix::V4("203.0.113.0/24".parse::<Ipv4Net>().unwrap());
+
+        let hdr = peer_hdr(peer_ip, PeerType::GlobalInstance, [0; 8], RibType::AdjRibInPrePolicy);
+        mgr.process(peer_up_msg(exporter_a, hdr.clone()));
+        mgr.process(peer_up_msg(exporter_b, hdr.clone()));
+
+        mgr.process(route_announce_msg(exporter_a, hdr.clone(), pfx.clone(), None, 100));
+        mgr.process(route_announce_msg(exporter_b, hdr.clone(), pfx.clone(), None, 200));
+
+        assert_eq!(mgr.total_routes(), 2, "two exporters monitoring same peer IP must not overwrite each other");
+        let key_a = PeerKey::from_header(exporter_a, &hdr);
+        let key_b = PeerKey::from_header(exporter_b, &hdr);
+        assert_eq!(
+            mgr.rib_for_peer_key(&key_a).unwrap().get(RibType::AdjRibInPrePolicy, &pfx).unwrap().attributes.local_pref,
+            Some(100)
+        );
+        assert_eq!(
+            mgr.rib_for_peer_key(&key_b).unwrap().get(RibType::AdjRibInPrePolicy, &pfx).unwrap().attributes.local_pref,
+            Some(200)
+        );
+
+        // Exporter B's peer goes down -> Exporter A's route must survive
+        mgr.process(BmpMessage {
+            id: uuid::Uuid::new_v4(),
+            received_at: Utc::now(),
+            speaker_addr: exporter_b,
+            payload: BmpPayload::PeerDown {
+                peer_header: hdr.clone(),
+                reason: PeerDownReason::RemoteSystemClosed2,
+            },
+        });
+        assert_eq!(mgr.total_routes(), 1, "peer down on exporter B must not clear exporter A's routes");
+        assert_eq!(mgr.rib_for_peer_key(&key_a).unwrap().count(RibType::AdjRibInPrePolicy), 1);
+        assert_eq!(mgr.rib_for_peer_key(&key_b).unwrap().count(RibType::AdjRibInPrePolicy), 0);
+
+        // Re-announce on B then terminate B -> Exporter A's route still survives
+        mgr.process(route_announce_msg(exporter_b, hdr.clone(), pfx.clone(), None, 250));
+        assert_eq!(mgr.total_routes(), 2);
+        mgr.process(BmpMessage {
+            id: uuid::Uuid::new_v4(),
+            received_at: Utc::now(),
+            speaker_addr: exporter_b,
+            payload: BmpPayload::Termination {
+                reason_code: 0,
+                reason_text: Some("admin".into()),
+            },
+        });
+        assert_eq!(mgr.total_routes(), 1);
+        assert!(mgr.rib_for_peer_key(&key_b).is_none());
+        assert_eq!(mgr.rib_for_peer_key(&key_a).unwrap().count(RibType::AdjRibInPrePolicy), 1);
+    }
