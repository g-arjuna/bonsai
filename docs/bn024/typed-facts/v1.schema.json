{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bonsai.dev/schemas/typed-fact/v1.json",
  "title": "Bonsai Typed Fact v1",
  "description": "Canonical typed-fact ABI (BN-024-02). Serialized form of bonsai::typed_facts::TypedFact. This schema describes data only; it confers no graph-write authority. Rust TypedFact::validate() is authoritative for invariants the schema cannot express (payload fields/state XOR, digest recomputation, grant-to-fact binding, lifecycle timestamps). Additive optional interface_identity refines interface subjects without changing existing v1 facts that omit it.",
  "type": "object",
  "required": [
    "schema_version",
    "fact_id",
    "fact_kind",
    "subject",
    "source",
    "observed_at",
    "payload",
    "payload_sha256",
    "evidence_sha256",
    "quality",
    "trust",
    "lifecycle"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Must equal the writer's SCHEMA_VERSION; newer versions are rejected pending explicit upgrade."
    },
    "fact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical identity tuple (entity key + observation key + interpretation identity + semantic payload digest + evidence digest) assigned by TypedFact::seal() and re-verified by validate()."
    },
    "fact_kind": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "required": ["device_id", "namespace"],
      "additionalProperties": false,
      "properties": {
        "device_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "description": "Canonical tenant/environment identity scope; absent = default scope." },
        "namespace": { "type": "string", "minLength": 1 },
        "network_namespace": { "type": "string", "description": "ASIC/network namespace (SONiC asic-0/host, FRR default, ...); independent of namespace." },
        "entity": { "type": "string", "description": "Entity identity within the namespace (interface name, prefix, neighbor address, ...)." },
        "vrf": { "type": "string" },
        "afi_safi": { "type": "string" },
        "plane": { "type": "string", "description": "Truth plane: operational | configured | effective | startup | ..." },
        "interface_identity": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["physical", "logical", "subinterface"], "description": "Coarse interface identity class. physical = base/physical interface; logical = non-numbered logical interface; subinterface = numbered child of a base interface." },
            "parent_entity": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Canonical parent/base interface entity. Required by Rust for subinterfaces; optional for logical interfaces; forbidden for physical base interfaces." },
            "subinterface_index": { "type": "integer", "minimum": 0, "description": "Numeric subinterface index. Required by Rust for subinterfaces, including zero; forbidden otherwise." },
            "vendor_native_name": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact source-native interface name/display evidence (for example Ethernet1.100). Evidence only; never parsed to infer identity axes." }
          },
          "description": "Optional structured interface identity refinement. Additive optional schema-v1 extension: absent means unknown/not supplied and preserves existing v1 fact identity. When present, Rust validate() enforces namespace/entity/parent/index consistency and the object participates in fact identity and authority binding. Entity remains the canonical parent/base key for numbered subinterfaces; network_namespace and vrf remain independent axes."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["collector_id", "source_kind", "capture_id", "session_epoch", "sequence"],
      "additionalProperties": false,
      "properties": {
        "collector_id": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "capture_id": { "type": "string", "minLength": 1 },
        "session_epoch": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 0 },
        "exporter_id": { "type": "string", "description": "Protocol-level exporter claim (BMP exporter, gNMI target, host key ref). Evidence only — never canonical device identity." }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "payload": {
      "type": "object",
      "required": ["produced_by", "parser_revision"],
      "additionalProperties": false,
      "properties": {
        "produced_by": { "type": "string", "minLength": 1 },
        "parser_revision": { "type": "string", "description": "Parser implementation revision identifying the exact extraction logic (template version, code version or content digest)." },
        "mapping_revision": { "type": "string", "description": "Normalization ruleset version applied after parsing; absent = no mapping layer recorded." },
        "fields": {
          "description": "Structured fact body (JSON object). Absent iff state is present; the fields/state XOR is enforced by Rust validate(), not by this schema."
        },
        "state": {
          "enum": ["empty", "invalid_input", "unsupported", "unstructured_fallback", "unknown_quality", "capture_failed", "no_usable_records", "output_budget_exhausted"],
          "description": "Required when fields is absent; forbidden when fields is present. 'capture_failed' = source capture failure; 'no_usable_records' = decoded input existed but no usable validated entity fact; 'output_budget_exhausted' = the effective output-fact budget prevented every entity fact. These degraded states are distinct from 'empty' (capture succeeded with a genuinely empty decoded population) and 'invalid_input' (input rejected before parsing). Must stay in sync with PayloadState in src/typed_facts.rs; drift is gated by tests/test_bn024_typed_facts.py against v1.states.fixture.json."
        }
      }
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical semantic payload (fields XOR state plus interpretation identity). Recomputed by validate(); post-seal mutation is detected."
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the canonical evidence reference list — binds the fact to its supporting observation content digests."
    },
    "quality": {
      "type": "object",
      "required": ["completeness"],
      "additionalProperties": false,
      "properties": {
        "completeness": { "enum": ["complete", "partial", "unknown"] },
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trust": {
      "enum": ["unverified", "device_asserted", "corroborated", "authoritative"],
      "description": "Authority eligibility CLAIM, separate from parse quality. A serialized claim is evidence only — it never satisfies authority eligibility by itself."
    },
    "authority": {
      "type": "object",
      "required": [
        "identity_status",
        "identity_scope",
        "subject_device_id",
        "namespace",
        "collector_id",
        "source_kind",
        "capture_id",
        "session_epoch",
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_status": { "enum": ["resolved", "provisional", "ambiguous", "unknown", "conflicting"] },
        "resolved_device_id": { "type": "string" },
        "resolved_exporter_id": { "type": "string" },
        "identity_scope": { "type": "string" },
        "subject_device_id": { "type": "string", "minLength": 1 },
        "subject_scope": { "type": "string" },
        "namespace": { "type": "string", "minLength": 1 },
        "network_namespace": { "type": "string" },
        "entity": { "type": "string" },
        "vrf": { "type": "string" },
        "afi_safi": { "type": "string" },
        "plane": { "type": "string" },
        "interface_identity": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["physical", "logical", "subinterface"], "description": "Coarse interface identity class. physical = base/physical interface; logical = non-numbered logical interface; subinterface = numbered child of a base interface." },
            "parent_entity": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Canonical parent/base interface entity. Required by Rust for subinterfaces; optional for logical interfaces; forbidden for physical base interfaces." },
            "subinterface_index": { "type": "integer", "minimum": 0, "description": "Numeric subinterface index. Required by Rust for subinterfaces, including zero; forbidden otherwise." },
            "vendor_native_name": { "type": "string", "minLength": 1, "maxLength": 256, "description": "Exact source-native interface name/display evidence (for example Ethernet1.100). Evidence only; never parsed to infer identity axes." }
          },
          "description": "Optional structured interface identity refinement. Additive optional schema-v1 extension: absent means unknown/not supplied and preserves existing v1 fact identity. When present, Rust validate() enforces namespace/entity/parent/index consistency and the object participates in fact identity and authority binding. Entity remains the canonical parent/base key for numbered subinterfaces; network_namespace and vrf remain independent axes."
        },
        "collector_id": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "capture_id": { "type": "string", "minLength": 1 },
        "session_epoch": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 0 },
        "exporter_id": { "type": "string" }
      },
      "description": "Authority grant evidence bound to this exact fact's subject/source axes. Grants are minted in-process from a trusted IdentityResolution; deserialized grants are unattested (attested flag is never serialized) and confer no eligibility. Rust validate() rejects grants whose bound axes do not match the fact."
    },
    "lifecycle": {
      "enum": ["active", "withdrawn", "superseded", "stale"]
    },
    "withdrawn_reason": { "type": "string", "minLength": 1 },
    "superseded_by": { "type": "string", "minLength": 1, "pattern": "^[0-9a-f]{64}$" },
    "lifecycle_changed_at": { "type": "string", "format": "date-time", "description": "Required for withdrawn/superseded; forbidden for active; optional for stale." },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "sha256"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "locator": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "withdrawn" } } },
      "then": { "required": ["withdrawn_reason"] }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "superseded" } } },
      "then": { "required": ["superseded_by"] }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "fact_kind": {
                "const": "lldp.neighbor"
              }
            },
            "required": [
              "fact_kind"
            ]
          },
          {
            "properties": {
              "payload": {
                "properties": {
                  "fields": {
                    "type": "object"
                  }
                },
                "required": [
                  "fields"
                ]
              }
            },
            "required": [
              "payload"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "properties": {
              "fields": {
                "type": "object",
                "required": [
                  "local_interface_name",
                  "protocol",
                  "remote_chassis_id",
                  "remote_chassis_id_subtype",
                  "remote_port_id",
                  "remote_port_id_subtype",
                  "remote_system_name",
                  "remote_port_description",
                  "remote_management_addresses",
                  "capabilities",
                  "ttl_seconds",
                  "age_seconds",
                  "coverage"
                ],
                "additionalProperties": false,
                "properties": {
                  "local_interface_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "normalized_local_interface_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "source_neighbor_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "capture_record_locator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "protocol": {
                    "const": "lldp"
                  },
                  "remote_chassis_id": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_chassis_id_subtype": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_port_id": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_port_id_subtype": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_system_name": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_port_description": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_management_addresses": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "capabilities": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "ttl_seconds": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "age_seconds": {
                    "type": "object",
                    "required": [
                      "state"
                    ],
                    "additionalProperties": true,
                    "properties": {
                      "state": {
                        "enum": [
                          "known",
                          "unknown",
                          "unsupported",
                          "invalid"
                        ]
                      }
                    }
                  },
                  "remote_chassis_id_raw": {
                    "type": "string"
                  },
                  "remote_port_id_raw": {
                    "type": "string"
                  },
                  "temporal": {
                    "type": "object"
                  },
                  "coverage": {
                    "type": "object",
                    "required": [
                      "capture_outcome",
                      "population_coverage",
                      "empty_local_interfaces"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "capture_outcome": {
                        "enum": [
                          "complete",
                          "partial",
                          "unavailable",
                          "failed",
                          "timed_out",
                          "truncated",
                          "unsupported",
                          "unknown"
                        ]
                      },
                      "population_coverage": {
                        "enum": [
                          "complete",
                          "partial",
                          "unknown"
                        ]
                      },
                      "empty_local_interfaces": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "empty_local_interface_names": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "capture_id": {
                        "type": "string"
                      },
                      "source_generation": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "observation_time": {
                        "type": "string"
                      },
                      "acquisition_scope": {
                        "type": "string"
                      },
                      "covered_interfaces": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "evidence_references": {
                        "type": "array"
                      }
                    }
                  }
                },
                "description": "BN-024-06 lldp.neighbor typed fields contract. Rust validation is authoritative for observed-field state/value consistency, subtype normalization, temporal evidence and subject/payload consistency."
              }
            }
          }
        }
      }
    }
  ]
}
